# Copy to .env and fill in. Never commit .env.
# `npm run dev` and `npm start` read it with Node's --env-file-if-exists.

# --- YouCam AI (Perfect Corp) ------------------------------------------------
# Your own YouCam API key (https://yce.perfectcorp.com). Without it the app runs
# in simulated mode: deterministic, clearly labeled demo results, no API calls.
YOUCAM_API_KEY=
# Set to "false" to switch YouCam off entirely (tools report "unavailable").
YOUCAM_ENABLED=
# YouCam units one session may spend (skin analysis 9-16, face 10-20, tone 20,
# look try-on 2, makeup try-on 1) and tasks the whole server may start per day.
YOUCAM_UNITS_PER_SESSION=100
YOUCAM_DAILY_TASK_CAP=300

# --- Security -----------------------------------------------------------------
# Secret used to sign session tokens. Required in production (32+ random chars):
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
PPRO_SIGNING_SECRET=
# Key a host (for example a Populi Professional) uses to create sessions.
# Required in production unless PPRO_STANDALONE=true, 24+ chars. In development
# one is generated per run and printed at startup.
PPRO_HOST_KEY=
# Comma-separated origins allowed to embed the app in an iframe and to receive
# its postMessage events, for example https://host.example. Never "*".
PPRO_ALLOWED_ORIGINS=

# --- Server -------------------------------------------------------------------
PORT=8787
# Public origin of this deployment (used in session launch links and the
# manifest). Required in production, for example https://beauty.example.com.
PPRO_PUBLIC_URL=http://localhost:8787
# "true" lets the bundled web app start its own demo sessions without a host.
# On by default in development, off in production.
PPRO_STANDALONE=
# Session length defaults, in minutes.
PPRO_SESSION_MINUTES=30
PPRO_MAX_SESSION_MINUTES=180
# Serve the MCP endpoint at /mcp (default true).
PPRO_MCP=true
