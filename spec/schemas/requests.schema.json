{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/yosun/ppro-app-youcam-beauty-advisor/main/spec/schemas/requests.schema.json",
  "title": "PPRO App request bodies",
  "$defs": {
    "createSession": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://raw.githubusercontent.com/yosun/ppro-app-youcam-beauty-advisor/main/spec/schemas/create-session.schema.json",
      "title": "Create a session",
      "type": "object",
      "properties": {
        "advisor": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "maxLength": 40
            },
            "pronouns": {
              "type": "string",
              "maxLength": 24
            },
            "persona": {
              "description": "Voice and personality notes for the advisor. Never shown to the client.",
              "type": "string",
              "maxLength": 1500
            }
          },
          "additionalProperties": false
        },
        "client": {
          "type": "object",
          "properties": {
            "display_name": {
              "type": "string",
              "maxLength": 40
            }
          },
          "additionalProperties": false
        },
        "minutes": {
          "type": "number",
          "minimum": 1,
          "maximum": 600
        },
        "agent_vision": {
          "description": "Let the advisor fetch image bytes of the client's photos. Off by default.",
          "type": "boolean"
        },
        "locale": {
          "type": "string",
          "maxLength": 16
        },
        "host_origin": {
          "description": "The embedding page's origin. Must be one the operator allowed.",
          "type": "string",
          "maxLength": 200
        },
        "units": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "consent": {
          "description": "Only if the host collected these from the client itself.",
          "type": "object",
          "properties": {
            "adult": {
              "type": "boolean"
            },
            "photo_analysis": {
              "type": "boolean"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "message": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://raw.githubusercontent.com/yosun/ppro-app-youcam-beauty-advisor/main/spec/schemas/message.schema.json",
      "title": "Send a message",
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4000
        },
        "role": {
          "description": "Required for a host (it relays the client). Otherwise implied by the token.",
          "type": "string",
          "enum": [
            "client",
            "agent"
          ]
        }
      },
      "required": [
        "text"
      ],
      "additionalProperties": false
    },
    "consent": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://raw.githubusercontent.com/yosun/ppro-app-youcam-beauty-advisor/main/spec/schemas/consent.schema.json",
      "title": "Record consent",
      "type": "object",
      "properties": {
        "adult": {
          "type": "boolean"
        },
        "photo_analysis": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "presence": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://raw.githubusercontent.com/yosun/ppro-app-youcam-beauty-advisor/main/spec/schemas/presence.schema.json",
      "title": "Set presence",
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "idle",
            "thinking",
            "speaking",
            "listening"
          ]
        }
      },
      "required": [
        "state"
      ],
      "additionalProperties": false
    },
    "uiEvent": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "$id": "https://raw.githubusercontent.com/yosun/ppro-app-youcam-beauty-advisor/main/spec/schemas/ui-event.schema.json",
      "title": "Report a client UI event",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "navigate"
            },
            "screen": {
              "type": "string",
              "maxLength": 24
            }
          },
          "required": [
            "type",
            "screen"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "follow"
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "focus"
            },
            "target": {
              "type": "string",
              "maxLength": 60
            }
          },
          "required": [
            "type",
            "target"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "view"
            },
            "view": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            }
          },
          "required": [
            "type",
            "view"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "capture"
            },
            "open": {
              "type": "boolean"
            }
          },
          "required": [
            "type",
            "open"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "dismiss"
            },
            "what": {
              "type": "string",
              "enum": [
                "notice",
                "media_request",
                "nudge"
              ]
            }
          },
          "required": [
            "type",
            "what"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "action"
            },
            "action": {
              "type": "string",
              "enum": [
                "copy",
                "save"
              ]
            },
            "target": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 60
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "type",
            "action"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
